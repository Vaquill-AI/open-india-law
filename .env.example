# Output directory for scraper JSONL / PDFs (default: ./data)
OUT_DIR=./data

# Optional. Several sources rate-limit or serve Indian traffic only; these
# scrapers can route through a proxy if one is configured. Everything runs
# without them, just slower or not at all from outside India.
DATAIMPULSE_USERNAME=
DATAIMPULSE_PASSWORD=
OXYLABS_USER=
OXYLABS_PASS=
USE_PROXY=false

# Optional. A few tribunal portals put a CAPTCHA in front of bulk listing.
CAPTCHA_API_KEY=

# Optional. Only needed by the OCR step, for scanned PDFs with no text layer.
MISTRAL_API_KEY=

# Optional. Only if you mirror scraped PDFs to S3-compatible object storage.
# The scrapers and the parsing pipeline do not need cloud access.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
